# GoQuiz Adventure Server Configuration
PORT=5050
TCP_PORT=5052
ENABLE_TCP=true

# Supabase Cloud Database Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Render Anti-Sleep Keep-Alive Configuration (Optional)
# If set, the server automatically pings itself every 10 minutes to prevent Render free-tier sleep
# Note: On Render, RENDER_EXTERNAL_URL is set automatically by the platform!
# RENDER_EXTERNAL_URL=https://your-app-name.onrender.com
SELF_PING_INTERVAL_MINUTES=10

