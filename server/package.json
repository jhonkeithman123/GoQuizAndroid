{
  "name": "goquiz-global-server",
  "version": "1.0.0",
  "description": "GoQuiz Adventure Global Real-Time Multiplayer Gateway & Leaderboard Server for Render (TypeScript)",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/server.ts",
