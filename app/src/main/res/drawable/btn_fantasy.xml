<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#744312" />
            <stroke android:width="2dp" android:color="#FFCA4E" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#1C2530" />
            <stroke android:width="1dp" android:color="#3A4858" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#232F3B" />
            <stroke android:width="1.5dp" android:color="#77E7A027" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
